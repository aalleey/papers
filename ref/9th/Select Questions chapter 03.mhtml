@charset "utf-8";

:root { --primary-color: #1976d2; --success-color: #28a745; --danger-color:=
 #dc3545; --bg-color: #f0f2f5; --header-height: 150px; }

body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, =
sans-serif; margin: 0px; padding-bottom: 100px; background-color: var(--bg-=
color); overflow-x: hidden; }

.fixed-header-wrapper { position: fixed; top: 0px; left: 0px; width: 100%; =
z-index: 1000; background: rgb(255, 255, 255); transition: transform 0.3s c=
ubic-bezier(0.4, 0, 0.2, 1); box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 5px; }

.header-collapsed { transform: translateY(-100%); }

.header-content { padding: 8px 12px; border-bottom: 1px solid rgb(224, 224,=
 224); }

h1 { text-align: center; margin: 0px 0px 8px; font-size: 16px; color: rgb(5=
1, 51, 51); }

.controls-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6p=
x; }

@media (max-width: 600px) {
  .controls-grid { grid-template-columns: 1fr; }
}

.control-group { background: rgb(248, 249, 250); padding: 6px; border-radiu=
s: 6px; border: 1px solid rgb(224, 224, 224); }

.control-group h3 { font-size: 11px; margin: 0px 0px 4px; text-align: cente=
r; color: rgb(102, 102, 102); text-transform: uppercase; letter-spacing: 0.=
5px; }

.switches, #language-controls, #source-controls { display: flex; justify-co=
ntent: space-around; flex-wrap: wrap; }

.switch-label { font-size: 16px; display: flex; align-items: center; cursor=
: pointer; margin: 0px 3px; white-space: nowrap; }

.switch-label input { margin-right: 4px; }

